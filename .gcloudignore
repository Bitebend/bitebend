# Google Cloud Run / Build ignore file
# Prevents bulky, transient, local development files from causing archive unpack or import failures

# Large / local dependencies & cache (Cloud Run rebuilds from package.json)
node_modules/
.pnpm-store/
.local/
.cache/

# Local IDEs & developer files
.git/
.github/
.vscode/
.idea/

# Local logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Documentation, screenshots, dev tests
screenshots/
docs/

# WhatsApp session cache and media uploads
services/whatsapp-bridge/.wwebjs_auth/
services/whatsapp-bridge/sessions/
services/whatsapp-bridge/uploads/*
