{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "node scripts/ensure-frontend-dist.mjs && npm --workspace=@workspace/api-server run start",
    "preinstall": "rm -f package-lock.json yarn.lock",
    "build": "npm --workspace=@workspace/menu run build && npm --workspace=@workspace/portal run build && npm --workspace=@workspace/api-server run build",
    "build:menu": "npm --workspace=@workspace/menu run build",
    "build:portal": "npm --workspace=@workspace/portal run build",
    "build:api": "npm --workspace=@workspace/api-server run build",
    "build:bridge": "pnpm --filter @workspace/whatsapp-bridge run build",
    "build:all": "npm --workspace=@workspace/menu run build && npm --workspace=@workspace/portal run build && npm --workspace=@workspace/api-server run build && pnpm --filter @workspace/whatsapp-bridge run build",
    "start": "npm --workspace=@workspace/api-server run start",
    "start:bridge": "pnpm --filter @workspace/whatsapp-bridge run start",
    "typecheck:libs": "tsc --build",
    "lint": "eslint artifacts/menu/src artifacts/portal/src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "bcryptjs": "^3.0.3"
  },
  "workspaces": {
    "packages": [
      "artifacts/*",
      "lib/*",
      "lib/integrations/*",
      "scripts",
      "services/*"
    ],
    "catalog": {
      "@replit/vite-plugin-cartographer": "^0.5.1",
      "@replit/vite-plugin-dev-banner": "^0.1.1",
      "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
      "@tailwindcss/vite": "^4.1.14",
      "@tanstack/react-query": "^5.90.21",
      "@types/node": "^25.3.3",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "@vitejs/plugin-react": "^5.0.4",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "drizzle-orm": "^0.45.2",
      "framer-motion": "^12.23.24",
      "lucide-react": "^0.545.0",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "tailwind-merge": "^3.3.1",
      "tailwindcss": "^4.1.14",
      "tsx": "4.21.0",
      "vite": "^7.3.2",
      "wouter": "^3.3.5",
      "zod": "^3.25.76"
    }
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "esbuild": "0.27.3"
  }
}